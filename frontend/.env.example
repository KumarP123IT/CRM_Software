# API Configuration
# Set to "false" to use real backend, "true" or leave unset to use mock data
VITE_USE_MOCKS=false

# Base URL for the backend API (only used when VITE_USE_MOCKS=false).
# Local dev: the Fastify API runs on :4000.
# Production (Docker/Caddy): leave unset or use "/api" — same-origin.
VITE_API_BASE_URL=http://localhost:4000/api

# Environment (development, staging, production)
VITE_ENV=development
