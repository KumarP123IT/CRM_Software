# API Configuration
# Set to "false" to use real backend, "true" or leave unset to use mock data
VITE_USE_MOCKS=true

# Base URL for the backend API (only used when VITE_USE_MOCKS=false)
VITE_API_BASE_URL=http://localhost:3000/api

# Environment (development, staging, production)
VITE_ENV=development
