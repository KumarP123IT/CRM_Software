# Konvo environment — copy to `.env` on the VPS and fill in real values.
# `docker compose` reads this file automatically for ${VAR} substitution.
# NEVER commit the real .env.

# ── Public address ─────────────────────────────────────────────────────────
# Host ports — must be unique on the VPS. Check before deploy:
#   sudo ss -tlnp | grep LISTEN && docker ps
# 8530 is already used by the host nginx on this VPS — we use 8531.
NGINX_HOST_PORT=8531      # the only public port — the app
BACKEND_HOST_PORT=8012    # 127.0.0.1 only, for curl debugging
FRONTEND_HOST_PORT=3612   # 127.0.0.1 only, for curl debugging

# "true" only when serving over HTTPS. With plain http://IP:port the browser
# rejects Secure cookies, so login would silently fail — keep "false".
COOKIE_SECURE=false

# ── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_USER=konvo
# openssl rand -hex 24 — hex/alphanumeric only: interpolated into
# DATABASE_URL, so @ : / would break the URL.
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=konvo

# ── Redis ──────────────────────────────────────────────────────────────────
# Required — BullMQ connects with it. Same URL-safety rule as above.
# openssl rand -hex 24
REDIS_PASSWORD=change-me-long-random

# ── Application secrets ────────────────────────────────────────────────────
# JWT signing secret — openssl rand -hex 32
JWT_SECRET=
# AES-256-GCM key for channel tokens at rest — exactly 64 hex chars.
# openssl rand -hex 32
ENCRYPTION_KEY=

# ── Public URLs ────────────────────────────────────────────────────────────
# Must match the exact origin users type in the browser (scheme + host + port).
# For IP access: http://31.97.232.68:8531  (replace with your address/port)
FRONTEND_URL=http://31.97.232.68:8531
PUBLIC_URL=http://31.97.232.68:8531
CORS_ORIGIN=http://31.97.232.68:8531

# VITE_* are inlined into the frontend bundle at image build time.
# "/api" = same-origin (correct behind nginx).
VITE_API_BASE_URL=/api
VITE_USE_MOCKS=false

# ── Optional ───────────────────────────────────────────────────────────────
# SMTP for transactional email (password reset). Without SMTP_HOST, mail is
# only logged and reset links are never delivered.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Konvo <no-reply@example.com>"

# WhatsApp Cloud API (Embedded Signup)
# WHATSAPP_APP_ID=
# WHATSAPP_APP_SECRET=

# pino log level — LOG_LEVEL=info
# Sentry error reporting — SENTRY_DSN=
# SENTRY_DSN=

# Encrypted off-server backups (see scripts/backup.sh)
# BACKUP_PASSPHRASE=
# BACKUP_REMOTE=s3://bucket/prefix
